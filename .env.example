# Project HQ configuration. Copy to `.env.local` (git-ignored) or export the variables in your shell.
# `npm run setup` writes HQ_ROOT for you. Environment variables win over `.env.local`; `.env.local` wins over defaults.
# Nothing here is a secret: Project HQ never needs a token on the server side. Local publishing uses your own git
# credentials (credential helper / SSH key); the GitHub token for PWA mode is entered in the app and stays in the browser.

# ---------------------------------------------------------------------------------------------------------------
# Local server (`npm start`, `npm run dev`, `vite preview`). Read by server/env.mjs via server/config.mjs.
# Settings → Local repository can write HQ_ROOT / HQ_CONTENT_DIR here for you. The desktop app does not read this file
# (it keeps its settings in settings.json in its data folder).
# ---------------------------------------------------------------------------------------------------------------

# Folder of your content git repository. Relative paths are relative to this app folder; absolute paths work too.
# Unset = demo mode: the bundled demo content is copied to a temporary folder and publishing is turned off.
# Example: HQ_ROOT=../my-hq-content
HQ_ROOT=

# Sub-folder of HQ_ROOT that holds the content (projects/, plan/). Must be inside HQ_ROOT. Default: content
HQ_CONTENT_DIR=content

# Port of `npm start` (always bound to 127.0.0.1). Default: 4173. (`npm run dev` uses Vite's port, 5173.)
PORT=4173

# How often (milliseconds) the open app checks the content folder for changes made by other tools
# (another editor, Claude Code or another coding agent, `git pull` in a terminal) and refreshes itself.
# 0 turns it off. Default: 3000
HQ_WATCH_INTERVAL_MS=3000

# ---------------------------------------------------------------------------------------------------------------
# Build-time values for the PWA / GitHub Pages build (`npm run build`). Read by src/storage/githubSettings.ts.
# They only PREFILL the Settings form and are baked into the PUBLIC bundle: never put a token here.
# In the GitHub Pages workflow they come from the repository variables HQ_CONTENT_REPO and HQ_CONTENT_BRANCH.
# ---------------------------------------------------------------------------------------------------------------

# "owner/repo" of your content repository. Default: empty (enter it in Settings).
VITE_HQ_REPO=

# Branch of the content repository. Default: main
VITE_HQ_BRANCH=main
