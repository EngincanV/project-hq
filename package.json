{
  "name": "project-hq",
  "private": true,
  "version": "0.1.0",
  "description": "A minimal, local-first headquarters for your side projects: notes, roadmap, planner, store and ads tracking, quick links. Content is plain Markdown in your own git repo.",
  "author": "Engincan Veske",
  "homepage": "https://github.com/EngincanV/project-hq#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EngincanV/project-hq.git"
  },
  "keywords": [
    "side-projects",
    "project-management",
    "markdown",
    "notes",
    "roadmap",
    "kanban",
    "planner",
    "indie-dev",
    "app-store",
    "google-play",
    "admob",
    "pwa",
    "git",
    "local-first"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "start": "node server/index.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sandbox": "node scripts/sandbox.mjs",
    "icons": "pwa-assets-generator",
    "icons:desktop": "node scripts/desktop-icons.mjs",
    "desktop:dev": "electron . --dev",
    "desktop:build": "npm run build && electron-builder --publish never",
    "desktop:smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.5.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "idb-keyval": "^6.3.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.78.0",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
